<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="ims.sso"
    >

  <genericsetup:upgradeStep
      title="Revert custom logout/login actions, update registry"
      profile="ims.sso:default"
      source="1"
      destination="2"
      handler=".upgrades.to_2"
      />

  <genericsetup:upgradeStep
      title="Remove login link on login pages"
      profile="ims.sso:default"
      source="2"
      destination="3"
      handler=".upgrades.to_3"
      />

</configure>
