<?xml version="1.0" encoding="utf-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/@@main_template/macros/master"
      xml:lang="en"
      i18n:domain="plone"
>

  <head>
    <metal:noborder fill-slot="top_slot"
                    tal:define="
                      dummy python:request.set('disable_border',1);
                      dummy python:request.set('disable_plone.leftcolumn', 1);
                      dummy python:request.set('disable_plone.rightcolumn', 1);
                    "
    >

    </metal:noborder>

    <body>
      <metal:main fill-slot="main"
                  tal:define="
                    portal context/@@plone_portal_state/portal;
                    target request/came_from|portal/absolute_url;
                  "
      >
        <div class="container">
          <div class="row">
            <tal:idp repeat="idp view/primary_idps">
              <div class="col"
                   metal:define-macro="idp_card"
                   tal:condition="idp/login|nothing"
              >
                <div class="card mb-4"
                     style="width:20em; height:20em"
                >
                  <div class="card-header">
                   ${idp/name}
                  </div>
                  <div class="card-body">
                    <p>${idp/description|nothing}</p>
                    <a class="btn btn-primary"
                       href="${idp/login}?target=${target}"
                    >Login</a>
                  </div>
                  <div class="card-footer"
                       tal:condition="idp/registration|nothing"
                  >
                  Need an account? Register
                    <a href="${idp/registration}">here</a>.
                  </div>
                </div>
              </div>
            </tal:idp>
          </div>
        </div>

        <div class="container mb-4 p-2 alert alert-info">
          For assistance, email an
          <a href="mailto:${view/from_address}">administrator</a>.<br />
          Please include the name of the site, the login service you are using, and any errors you have received.
        </div>

        <div tal:condition="view/secondary_idps">
          <ul class="list-unstyled">
            <tal:idp repeat="idp view/secondary_idps">
              <li>
                <a href="${idp/login}?target=${target}">Sign in with ${idp/name}</a>
              </li>
              <li tal:condition="idp/registration|nothing">
                <a href="${idp/registration}">
              Register with ${idp/name}
                </a>
              </li>
            </tal:idp>
          </ul>
        </div>
      </metal:main>
    </body>
  </head></html>
